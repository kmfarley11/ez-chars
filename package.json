{
	"name": "ez-chars",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest run --project=unit",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:all": "playwright test --workers=1",
		"test:perf": "PLAYWRIGHT_PERF=1 playwright test tests/performance.perf.spec.ts --project=chromium",
		"test:perf:compare": "PLAYWRIGHT_PERF=1 playwright test tests/performance.perf.spec.ts --project=chromium --project=firefox --workers=1 --repeat-each=3 --reporter=line,./tests/performanceComparisonReporter.ts",
		"test:coverage": "vitest run --project=unit --coverage",
		"test:watch": "vitest --project=unit",
		"mcp:svelte": "svelte-mcp",
		"format": "prettier --write . && prettier --write \"src/**/*.{js,ts}\" --plugin prettier-plugin-tailwindcss",
		"lint": "prettier --check . && prettier --check \"src/**/*.{js,ts}\" --plugin prettier-plugin-tailwindcss && eslint .",
		"deploy": "vite build && touch build/.nojekyll && npx gh-pages -d build -t && echo \"View deployed site: https://kmfarley11.github.io/ez-chars/\" && echo \"Monitor deploy branch/status: https://github.com/kmfarley11/ez-chars/tree/gh-pages\"",
		"storybook": "STORYBOOK=1 storybook dev -p 6006 --no-open --disable-telemetry",
		"build-storybook": "STORYBOOK=1 storybook build --disable-telemetry",
		"test:storybook": "STORYBOOK_TEST=1 vitest --project=storybook",
		"verify:smoke": "npm run check && npm run lint && npm run test && npm run test:e2e && npm run test:storybook -- --run",
		"verify:all": "env -u npm_config_allow_scripts npm audit && npm run check && npm run lint && npm run test && npm run test:coverage && npm run build && npm run build-storybook && npm run test:storybook -- --run && npm run test:e2e:all && npm run test:perf"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@fission-ai/openspec": "1.6.0",
		"@playwright/test": "1.62.1",
		"@storybook/addon-a11y": "10.6.4",
		"@storybook/addon-vitest": "10.6.4",
		"@storybook/sveltekit": "10.6.4",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/mcp": "^0.1.24",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/connect": "^3.4.38",
		"@types/node": "^25.3.2",
		"@typescript-eslint/parser": "^8.56.1",
		"@vitest/browser-playwright": "4.1.12",
		"@vitest/coverage-v8": "4.1.12",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"gh-pages": "^6.3.0",
		"globals": "^16.0.0",
		"playwright": "1.62.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"storybook": "10.6.4",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "^4.0.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.12",
		"zod": "4.6.6"
	},
	"dependencies": {
		"immutable-json-patch": "^6.0.2",
		"pdfjs-dist": "5.5.207",
		"tailwind-merge": "^3.3.0"
	},
	"overrides": {
		"brace-expansion": "5.0.12",
		"postcss-selector-parser": "7.1.6"
	}
}
