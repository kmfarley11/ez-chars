{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", ".storybook", "*.ts", "*.js", ".svelte-kit/**/*.d.ts"],
	"exclude": ["node_modules", "build", "storybook-static", "coverage"],
	"files": ["playwright.config.ts"],
	"compilerOptions": {
		"allowJs": true,
		// Required so TS accepts Svelte component imports/types (e.g. .svelte -> .d.svelte.ts).
		"allowArbitraryExtensions": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"types": ["node", "$app/types"],
		"paths": {
			"$lib/*": ["./src/lib/*"],
			"$storage/*": ["./src/lib/storage/*"],
			"$utils/*": ["./src/lib/utils/*"],
			"$fixtures/*": ["./src/fixtures/*"]
		},
		"moduleResolution": "bundler"
	}
	// Existing aliases are explicitly supplied by sveltekit.config.js.
}
